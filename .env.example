# =============================================================================
# Morphyard environment variables - copy to .env and adjust (.env is git-ignored)
#
# config/config.yaml reads these through ${VAR:-default}; every variable below
# has a default, so a bare `uv run python main.py` works for local development.
# =============================================================================

# --- Server -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5055
LOG_LEVEL=INFO

# --- Authentication (MCP Gate) ------------------------------------------------
# The MCP Gate instance that issues tokens for this server (its OAUTH_ISSUER).
MCP_GATE_URL=http://localhost:4568
# The address this server is reached at. Register the same host and port in MCP Gate;
# the token audience is derived from it as <MORPHYARD_BASE_URL>/mcp and must match exactly.
MORPHYARD_BASE_URL=http://127.0.0.1:5055
# Set to false only for local experiments without MCP Gate.
AUTH_ENABLED=true
# MCP Gate revocation feed (docs/configuration.md -> "Token revocation"): revoked tokens stop working
# within one poll interval instead of at expiry. Needs a confidential client registered in
# MCP Gate and bound to Morphyard as its resource server.
MORPHYARD_REVOCATION_ENABLED=false
MORPHYARD_REVOCATION_CLIENT_ID=
MORPHYARD_REVOCATION_CLIENT_SECRET=
MORPHYARD_REVOCATION_POLL_INTERVAL=30
# open = keep accepting tokens while MCP Gate is unreachable; closed = reject them all once stale
MORPHYARD_REVOCATION_FAIL_MODE=open

# --- Conversion ---------------------------------------------------------------
MAX_INPUT_MB=50
ENGINE_TIMEOUT=180
# Conversions running at once (every engine counts); empty = the CPUs available, at most 8.
MORPHYARD_MAX_CONCURRENT_CONVERSIONS=
# How many more may wait for a slot; empty = 4 x the limit, 0 = refuse at once when all are busy.
MORPHYARD_MAX_QUEUED_CONVERSIONS=
# Seconds a request may wait for a slot before it is refused as busy.
MORPHYARD_QUEUE_TIMEOUT=30

# --- Stored files and download links --------------------------------------------
# Results are kept on the server for a short time and handed out as signed, expiring links.
# Directory for the store and the generated signing key (Docker: mount a volume at /app/data).
MORPHYARD_DATA_DIR=./data
# Address people's browsers and agents reach this server at; empty = MORPHYARD_BASE_URL.
MORPHYARD_PUBLIC_URL=
# Key that signs download links (at least 32 characters, e.g. `openssl rand -hex 32`).
# Empty = generated once into <MORPHYARD_DATA_DIR>/.signing_key. Changing or losing it deletes
# the stored files at the next start, because their links can no longer be checked.
MORPHYARD_SIGNING_KEY=
# Seconds a file is kept (at most 86400).
MORPHYARD_FILE_TTL_SEC=3600
# Store caps in MB: whole store and per person. When full, new files are refused.
MORPHYARD_STORE_MAX_MB=2048
MORPHYARD_STORE_OWNER_MAX_MB=512
# How tools return files: auto (link, plus base64 for files up to MORPHYARD_INLINE_MAX_MB),
# inline (base64 only, as in 1.3), both, or link (link only).
MORPHYARD_RESULT_DELIVERY=auto
MORPHYARD_INLINE_MAX_MB=10
